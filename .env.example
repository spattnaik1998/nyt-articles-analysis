# NYT Article Analytics Platform - Environment Configuration
#
# LOCAL DEVELOPMENT ONLY
# =====================
# This file is for local development. Never commit actual API keys.
# For production (GCP Cloud Run), secrets are managed via GCP Secret Manager.
#
# To use locally:
# 1. Copy this file to .env
# 2. Fill in your actual API keys
# 3. Add .env to .gitignore (it already is)
# 4. Never commit .env to git

# OpenAI API Key (for book extraction and LLM-based features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Serper API Key (for web search)
# Get your API key from: https://serper.dev/
SERPER_API_KEY=your-serper-api-key-here

# Tavily API Key (for web search verification)
# Get your API key from: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# Google/Gemini API Key (for book verification)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Set the model to use (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: API settings
# OPENAI_ORG_ID=your-org-id-here
# OPENAI_TIMEOUT=60

# Embedding Microservice
# Set EMBEDDING_SERVICE_URL to delegate embedding calls to the standalone service.
# Without it, BERTweet is loaded directly in the main app (original behaviour).
# EMBEDDING_SERVICE_URL=http://localhost:8001
# EMBEDDING_SERVICE_TIMEOUT=5.0
# LOAD_LOCAL_EMBEDDING_FALLBACK=false   # set true to keep local model as fallback

# Redis Distributed Cache
# Set REDIS_URL to enable Redis. Without it, in-memory fallback is used.
# REDIS_URL=redis://localhost:6379/0
# REDIS_POOL_MAX_CONNECTIONS=20
# REDIS_SOCKET_TIMEOUT=0.5
# REDIS_CONNECT_TIMEOUT=1.0

# Application Settings (optional)
# ENVIRONMENT=development
# LOG_LEVEL=INFO
